# Google Gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Document chunking
CHUNK_SIZE=350
CHUNK_OVERLAP=60

# Retrieval
TOP_K=4

# ChromaDB
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=kigali_hometech_documents

# Backend
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5174
